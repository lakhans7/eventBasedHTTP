# Copy to .env for local development. Never commit the real .env file.

APP_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fiverr_saas?sslmode=disable

# Redis (asynq job queue)
REDIS_ADDR=localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-value
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Google OAuth (optional — leave blank to disable "Continue with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/api/v1/auth/google/callback

# Reserved for a future official Fiverr OAuth integration. Unused today —
# see docs/fiverr-api-capabilities.md. Do not populate.
FIVERR_TOKEN_ENC_KEY=

# AI Assistant (optional — leave ANTHROPIC_API_KEY blank to run with mock AI responses)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MAX_OUTPUT_TOKENS=1024
AI_DAILY_USER_BUDGET_USD=2.00

# Email (optional — leave SMTP_HOST blank to log emails to the console instead of sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
