# Copy to .env for local development. Never commit the real .env file.

PORT=3000
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

STORE_NAME=Your Store Name
PRODUCT_NAME=Red Lace Nightdress
CURRENCY=INR
# The price (₹799) is intentionally not an env var — it's set once in
# internal/config/config.go so a misconfigured/missing env var can never
# accidentally undercharge a customer. Change it there if it ever changes.

# Get test-mode keys from https://dashboard.razorpay.com/app/keys (Test Mode
# toggle, top right) — safe to use while developing, no real money moves.
# Switch to live keys only once your Razorpay account is fully KYC-verified.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: only needed if you configure a webhook in the Razorpay dashboard
# (Settings → Webhooks) pointing at https://<your-domain>/api/webhook/razorpay
# for the "payment.captured" event. Leave blank to disable /api/webhook/razorpay.
RAZORPAY_WEBHOOK_SECRET=

# Local backup order log (see README.md "Persistence"). The Razorpay
# dashboard is the real source of truth — this is a convenience copy.
ORDERS_LOG_PATH=orders.jsonl
